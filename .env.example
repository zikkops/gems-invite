# ---------------------------------------------------------------------------
# Square payments — copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored and must never be committed.
#
# All four values come from the Square Developer Dashboard:
#   https://developer.squareup.com/apps
# Open your application, then pick Sandbox or Production in the left rail —
# each environment has its own set of credentials.
# ---------------------------------------------------------------------------

# "Credentials" page → Access token. SECRET. Server-side only.
# Sandbox tokens are labelled "Sandbox Access Token"; production tokens require
# the app to be activated and start with EAAA.
SQUARE_ACCESS_TOKEN=

# "Locations" page → Location ID of the location the money should land in.
SQUARE_LOCATION_ID=

# `sandbox` while testing, `production` when you are ready to take real cards.
SQUARE_ENVIRONMENT=sandbox

# "Credentials" page → Application ID. Publishable: it is sent to the browser,
# which is why it carries the NEXT_PUBLIC_ prefix. Sandbox ids begin with
# `sandbox-sq0idb-`; production ids begin with `sq0idp-`.
NEXT_PUBLIC_SQUARE_APPLICATION_ID=

# The same location id as above, exposed to the browser (the Web Payments SDK
# needs it to build the card form).
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# Optional — defaults to USD. Must match the currency of your Square location.
# SQUARE_CURRENCY=USD

# ---------------------------------------------------------------------------
# Order notifications — who is emailed when a sponsorship is paid.
# Comma-separated; every address gets the same message.
# ---------------------------------------------------------------------------
ORDER_NOTIFICATION_EMAILS=info@gemsworlddialogue.com

# ---------------------------------------------------------------------------
# The mailbox the notification is sent FROM.
#
# In Hostinger hPanel: Emails -> your domain -> the mailbox -> "Connect apps
# & devices" / configuration settings. Create the mailbox first if it does not
# exist, and use ITS password here (not your hPanel login).
#
# Hostinger refuses a From address that is not the mailbox you authenticated
# as, so SMTP_USER must be a real mailbox on gemsworlddialogue.com.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@gemsworlddialogue.com
SMTP_PASS=

# Optional. Defaults to "Earth Soiree <SMTP_USER>".
# SMTP_FROM=The Earth Soiree <info@gemsworlddialogue.com>

# Set to any long random string to enable /api/test-notification, which sends
# a sample order to the recipients above without taking a card. The endpoint
# returns 404 while this is unset.
NOTIFY_TEST_SECRET=
